{
	"name": "text-splitter",
	"version": "0.1.0",
	"description": "Splits an element's text into the lines, words, and characters the browser already painted.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Azur1337/text-splitter.git"
	},
	"keywords": [
		"text",
		"split",
		"lines",
		"words",
		"characters",
		"grapheme",
		"animation",
		"reveal",
		"dom"
	],
	"license": "MIT",
	"scripts": {
		"build": "vite build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"happy-dom": "^15.0.0",
		"typescript": "^5.5.0",
		"vite": "^5.4.0",
		"vitest": "^2.0.0"
	}
}
